# ─── Backend (Express server) ────────────────────────────────────────────────

# Server port (default 5000)
PORT=5000

# Secret used to sign sessions — any random string works locally
SESSION_SECRET=replace-with-any-random-string

# OpenAI API key — get one at https://platform.openai.com/api-keys
# (Inside Replit this is provided automatically via Replit AI Integrations)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...your-openai-key-here...

# OpenAI base URL — leave as-is for standard OpenAI
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Spotify credentials — create a free app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ─── Frontend (Expo) ─────────────────────────────────────────────────────────

# The domain your Express backend is running on.
# Locally: use your computer's local IP (NOT localhost — Expo on phone can't reach localhost)
# Find your IP with: ipconfig (Windows) or ifconfig (Mac/Linux), look for 192.168.x.x
EXPO_PUBLIC_DOMAIN=192.168.1.x:5000
